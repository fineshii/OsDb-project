# Server configuration
PORT=5000
NODE_ENV=development

# MySQL Database configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=cloud_simulator

# File Upload limits
MAX_FILE_SIZE_MB=10

# Socket payload threshold (1MB in bytes). Larger files are fetched via REST API.
MAX_SOCKET_PAYLOAD=1048576

# Master URL for workers
MASTER_URL=http://localhost:5000

